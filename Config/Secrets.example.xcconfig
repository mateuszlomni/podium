// Copy to Secrets.xcconfig (ignored by git) and fill in your own values.

// A bundle ID you own; also add it under "iOS app bundles" in the Spotify dashboard.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.podium

// Your Apple team ID (Xcode > Settings > Accounts); needed to run on an iPhone.
DEVELOPMENT_TEAM =

// Client ID of your app in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID =
